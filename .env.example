# Copy this file to .env and fill in your real keys.
# Example in PowerShell:
# Copy-Item .env.example .env

GEMINI_API_KEY=paste_your_gemini_key_here

# ChatGPT / OpenAI (official API)
CHATGPT_API_KEY=paste_your_chatgpt_key_here
# Optional secondary key. OPENAI_API_KEY_FALLBACK is also accepted as an alias.
CHATGPT_API_KEY_FALLBACK=

# OpenAI processing: auto (project default), default (Standard), or flex (lower cost, slower).
# Applies only to official OpenAI calls. Verify Flex support for every selected OpenAI model.
OPENAI_SERVICE_TIER=auto

# Local permission file: .cache/llm_error_permissions.json
# Scripts/notebooks use a desktop dialog (terminal fallback); off keeps legacy retries.
LLM_ERROR_RECOVERY=auto

# OpenRouter (OpenAI-compatible)
OPENROUTER_API_KEY=paste_your_openrouter_key_here
# Optional: identifies your app for OpenRouter ranking
OPENROUTER_HTTP_REFERER=
OPENROUTER_X_TITLE=misinformation-llm-simulation

# DeepSeek (official API, OpenAI-compatible)
DEEPSEEK_API_KEY=paste_your_deepseek_key_here

# Grok / xAI (official API, OpenAI-compatible)
GROK_API_KEY=paste_your_grok_key_here

# Local OpenAI-compatible endpoint (optional)
LOCAL_OPENAI_API_KEY=ollama
LOCAL_OPENAI_BASE_URL=http://127.0.0.1:11434/v1

# NewsData.io
NEWSDATA_API_KEY=paste_your_newsdata_key_here
